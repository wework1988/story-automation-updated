# ---------------------------------------------------------------------------
# Story agent — local research & generated output (do not commit)
# ---------------------------------------------------------------------------
research-storage-stories/**
!research-storage-stories/.gitkeep

story-agent/output/**
!story-agent/output/.gitkeep

# ---------------------------------------------------------------------------
# Raw story scripts & inputs (local only — keep queue.txt)
# ---------------------------------------------------------------------------
general-story/story-to-run/*
!general-story/story-to-run/queue.txt
crime-section/story-to-run/*
!crime-section/story-to-run/queue.txt
english-story/story-to-run/*
!english-story/story-to-run/queue.txt
english-story/general-story/story-to-run/*
english-story/general-story/stories/

elevenlabs-audio/input/*
!elevenlabs-audio/input/.gitkeep

# ---------------------------------------------------------------------------
# CMS pipeline outputs (prompts, scenes, audio from Drupal worker)
# ---------------------------------------------------------------------------
cms-generate-stories/**
!cms-generate-stories/.gitkeep

# ---------------------------------------------------------------------------
# Pipeline outputs (generated by run_with_params.sh — do not commit)
# Ignores EVERY folder inside stories/ (all slugs, any depth), e.g.:
#   general-story/stories/cockroach/
#   general-story/stories/hafiz-attacked-house/
#   general-story/stories/completed/bangladesh-diffcountry/
# ---------------------------------------------------------------------------
general-story/stories/
crime-section/stories/
english-story/stories/

# ---------------------------------------------------------------------------
# Secrets & local env
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# ElevenLabs audio outputs (generated MP3s)
# ---------------------------------------------------------------------------
elevenlabs-audio/output/*
!elevenlabs-audio/output/.gitkeep

# ---------------------------------------------------------------------------
# Logs & temp
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
