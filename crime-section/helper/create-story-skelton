#!/usr/bin/env bash
#
# Story folder helper
# -----------------------------
# Edit STORY_NAME and STAGE below, save, then run this script (no arguments needed).
#
# STAGE — which operation runs (only one at a time):
#   empty, 1, step1, or stage1 → create new story folder + templates (same as before)
#   2, step2, or stage2       → inject FULL_STORY.txt into template/STORY_Config_<name>.md
#   3, step3, or stage3       → inject output_config + FULL_STORY into template/Story_scene_breakdown_<name>.md
#   4, step4, or stage4       → inject output_config + output_story_breakdown into template/<name>_stage-c-image-motion.md
#
# Optional CLI (overrides nothing unless you pass a step or story slug):
#   ./create-story-skelton                     → use STAGE + STORY_NAME from this file
#   ./create-story-skelton other-slug          → same STAGE as in file, but STORY_NAME=other-slug
#   ./create-story-skelton step 2 other-slug   → force step 2 for this run (optional)
#
# Creates (STAGE 1 only) under stories/<STORY_NAME>/:
#   At the story folder root:
#   - FULL_STORY.txt, output_config_<STORY_NAME>.md, output_story_breakdown_<STORY_NAME>.md, prompt.txt
#   Under template/ (verbatim cp from bifuracted-template):
#   - STORY_Config_<STORY_NAME>.md, Story_scene_breakdown_<STORY_NAME>.md, <STORY_NAME>_stage-c-image-motion.md, character.txt
#
# -----------------------------
STORY_NAME="spain-bhoot"
# STAGE: leave empty or 1 = new folder; 2 = fill STORY_Config; 3 = fill Story_scene_breakdown; 4 = fill Stage C motion template
STAGE="1"
# -----------------------------

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STORIES_DIR="$ROOT/stories"
TEMPLATE_DIR="$ROOT/bifuracted-template"

# Default slug from the block above (overridable by CLI).
DEFAULT_STORY_NAME="${STORY_NAME}"

usage() {
  echo "Usage:" >&2
  echo "  Set STORY_NAME and STAGE at the top of this script, then run:  $0" >&2
  echo "  Optional:  $0 [<story_slug>]  (override STORY_NAME; STAGE still from file)" >&2
  echo "  Optional:  $0 [step|stage] <1|2|3|4> [<story_slug>]  (override step for this run)" >&2
  echo "  STAGE empty or 1 → new story folder; 2 → STORY_Config; 3 → Story_scene_breakdown; 4 → stage-c-image-motion (config + breakdown slots)" >&2
  exit 1
}

mode_from_file() {
  local s
  s="$(printf '%s' "${STAGE:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  case "$s" in
    "" | 1 | step1 | stage1)
      MODE=step1
      ;;
    2 | step2 | stage2)
      MODE=step2
      ;;
    3 | step3 | stage3)
      MODE=step3
      ;;
    4 | step4 | stage4)
      MODE=step4
      ;;
    *)
      echo "Error: invalid STAGE=${STAGE:-} (use empty, 1, 2, 3, or 4 — or step2 / stage4, etc.)." >&2
      exit 1
      ;;
  esac
}

parse_cmdline() {
  MODE=""
  local -a rest=("$@")

  if [[ ${#rest[@]} -ge 2 ]]; then
    local a="${rest[0]}" b="${rest[1]}"
    if [[ ( "$a" == "step" || "$a" == "stage" ) && "$b" =~ ^[1234]$ ]]; then
      MODE="step$b"
      rest=("${rest[@]:2}")
      if [[ ${#rest[@]} -ge 1 ]]; then
        STORY_NAME="${rest[0]}"
      fi
      return
    fi
    usage
  fi

  if [[ ${#rest[@]} -eq 1 ]]; then
    local f="${rest[0]}"
    case "$f" in
      step1 | stage1)
        MODE=step1
        return
        ;;
      step2 | stage2)
        MODE=step2
        return
        ;;
      step3 | stage3)
        MODE=step3
        return
        ;;
      step4 | stage4)
        MODE=step4
        return
        ;;
      1)
        MODE=step1
        return
        ;;
      2)
        MODE=step2
        return
        ;;
      3)
        MODE=step3
        return
        ;;
      4)
        MODE=step4
        return
        ;;
      *)
        mode_from_file
        STORY_NAME="$f"
        return
        ;;
    esac
  fi

  mode_from_file
}

require_story_name() {
  if [[ -z "${STORY_NAME}" ]]; then
    STORY_NAME="${DEFAULT_STORY_NAME}"
  fi
  if [[ -z "${STORY_NAME}" ]]; then
    echo "Error: set STORY_NAME in $0 or pass <story_name> on the command line." >&2
    exit 1
  fi
  if [[ "$STORY_NAME" == *"/"* || "$STORY_NAME" == *..* ]]; then
    echo "Error: story name must be a single path segment (no slashes or '..')." >&2
    exit 1
  fi
}

sanitize_dest() {
  DEST="$STORIES_DIR/$STORY_NAME"
}

step1_create() {
  sanitize_dest
  if [[ -e "$DEST" ]]; then
    echo "Error: already exists: $DEST" >&2
    exit 1
  fi

  if [[ ! -d "$TEMPLATE_DIR" ]]; then
    echo "Error: template directory not found: $TEMPLATE_DIR" >&2
    exit 1
  fi

  mkdir -p "$DEST"
  local STORY_TMPL_SUB="$DEST/template"
  mkdir -p "$STORY_TMPL_SUB"

  : > "$DEST/FULL_STORY.txt"
  : > "$DEST/output_config_${STORY_NAME}.md"
  : > "$DEST/output_story_breakdown_${STORY_NAME}.md"
  : > "$DEST/prompt.txt"

  shopt -s nullglob
  local src base base_lc
  for src in "$TEMPLATE_DIR"/*; do
    base="$(basename "$src")"
    base_lc="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
    if [[ ! -f "$src" || "$base_lc" == "readme.md" ]]; then
      continue
    fi
    case "$base" in
      stage-a-story-config.md)
        cp "$src" "$STORY_TMPL_SUB/STORY_Config_${STORY_NAME}.md"
        ;;
      stage-b-scene-breakdown.md)
        cp "$src" "$STORY_TMPL_SUB/Story_scene_breakdown_${STORY_NAME}.md"
        ;;
      character.txt)
        cp "$src" "$STORY_TMPL_SUB/character.txt"
        ;;
      *)
        cp "$src" "$STORY_TMPL_SUB/${STORY_NAME}_${base}"
        ;;
    esac
  done
  shopt -u nullglob

  echo "Created story skeleton at $DEST"
  echo "  (root)"
  echo "  - FULL_STORY.txt"
  echo "  - output_config_${STORY_NAME}.md"
  echo "  - output_story_breakdown_${STORY_NAME}.md"
  echo "  - prompt.txt"
  echo "  template/"
  echo "  - STORY_Config_${STORY_NAME}.md"
  echo "  - Story_scene_breakdown_${STORY_NAME}.md"
  echo "  - ${STORY_NAME}_stage-c-image-motion.md"
  echo "  - character.txt"
}

step2_fill_story_config() {
  sanitize_dest
  local s_conf="$DEST/template/STORY_Config_${STORY_NAME}.md"
  local full="$DEST/FULL_STORY.txt"

  if [[ ! -f "$s_conf" ]]; then
    echo "Error: missing $s_conf (run step 1 first)." >&2
    exit 1
  fi
  if [[ ! -f "$full" ]]; then
    echo "Error: missing $full" >&2
    exit 1
  fi

  python3 - "$s_conf" "$full" <<'PY'
import pathlib, sys
story_md = pathlib.Path(sys.argv[1])
full_path = pathlib.Path(sys.argv[2])
full = full_path.read_text(encoding="utf-8")
t = story_md.read_text(encoding="utf-8")
old = "{Paste the full Hindi / Hinglish / English story here.}"
if old not in t:
    sys.exit("error: placeholder not found in STORY_Config (file already filled or wrong version?): " + old)
story_md.write_text(t.replace(old, full, 1), encoding="utf-8")
PY

  echo "Updated $s_conf with text from $full"
}

step3_fill_scene_breakdown() {
  sanitize_dest
  local b_md="$DEST/template/Story_scene_breakdown_${STORY_NAME}.md"
  local full="$DEST/FULL_STORY.txt"
  local cfg="$DEST/output_config_${STORY_NAME}.md"

  if [[ ! -f "$b_md" ]]; then
    echo "Error: missing $b_md (run step 1 first)." >&2
    exit 1
  fi
  if [[ ! -f "$full" ]]; then
    echo "Error: missing $full" >&2
    exit 1
  fi
  if [[ ! -f "$cfg" ]]; then
    echo "Error: missing $cfg" >&2
    exit 1
  fi

  python3 - "$b_md" "$full" "$cfg" <<'PY'
import pathlib, sys
scene_md = pathlib.Path(sys.argv[1])
full = pathlib.Path(sys.argv[2]).read_text(encoding="utf-8")
ocfg = pathlib.Path(sys.argv[3]).read_text(encoding="utf-8")
t = scene_md.read_text(encoding="utf-8")
p_cfg = "{Paste the STORY CONFIG BLOCK output from Stage A here.}"
p_full = "{Paste the full Hindi / Hinglish / English story here — same as used in Stage A.}"
if p_cfg not in t:
    sys.exit("error: missing placeholder: " + p_cfg)
if p_full not in t:
    sys.exit("error: missing placeholder: " + p_full)
t = t.replace(p_cfg, ocfg, 1).replace(p_full, full, 1)
scene_md.write_text(t, encoding="utf-8")
PY

  echo "Updated $b_md with $cfg and $full"
}

step4_fill_stage_c() {
  sanitize_dest
  local c_md="$DEST/template/${STORY_NAME}_stage-c-image-motion.md"
  local cfg="$DEST/output_config_${STORY_NAME}.md"
  local brk="$DEST/output_story_breakdown_${STORY_NAME}.md"

  if [[ ! -f "$c_md" ]]; then
    echo "Error: missing $c_md (run step 1 first)." >&2
    exit 1
  fi
  if [[ ! -f "$cfg" ]]; then
    echo "Error: missing $cfg" >&2
    exit 1
  fi
  if [[ ! -f "$brk" ]]; then
    echo "Error: missing $brk" >&2
    exit 1
  fi

  python3 - "$c_md" "$cfg" "$brk" <<'PY'
import pathlib, sys
stage_c = pathlib.Path(sys.argv[1])
ocfg = pathlib.Path(sys.argv[2]).read_text(encoding="utf-8")
obrk = pathlib.Path(sys.argv[3]).read_text(encoding="utf-8")
t = stage_c.read_text(encoding="utf-8")
p_cfg = "{Paste the STORY CONFIG BLOCK output from Stage A here.}"
p_brk = "{Paste the LOCKED SCENE BREAKDOWN output from Stage B here.}"
if p_cfg not in t:
    sys.exit("error: missing placeholder: " + p_cfg)
if p_brk not in t:
    sys.exit("error: missing placeholder: " + p_brk)
t = t.replace(p_cfg, ocfg, 1).replace(p_brk, obrk, 1)
stage_c.write_text(t, encoding="utf-8")
PY

  echo "Updated $c_md with $cfg and $brk"
}

# --- main ---

parse_cmdline "$@"
require_story_name

case "$MODE" in
  step1) step1_create ;;
  step2) step2_fill_story_config ;;
  step3) step3_fill_scene_breakdown ;;
  step4) step4_fill_stage_c ;;
  *) usage ;;
esac
